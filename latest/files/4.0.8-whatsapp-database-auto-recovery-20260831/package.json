{
  "name": "bi-talks-windows-desktop-source-build",
  "version": "4.0.8",
  "author": "Bi-talks contributors",
  "private": true,
  "os": [
    "win32"
  ],
  "description": "Windows 10/11 multi-account desktop messenger shell with fast message translation",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-icon.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:core": "node --experimental-strip-types --test src/main/signalUpdateUtils.test.mjs src/main/stateSecrets.test.mjs src/main/runtimeLog.test.mjs src/main/appPatchUtils.test.mjs src/main/translationUsage.test.mjs",
    "patch:keygen": "node scripts/create-patch-signing-key.mjs",
    "patch:build": "node scripts/build-app-patch.mjs",
    "patch:verify": "node --experimental-strip-types scripts/verify-app-patch.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:portable": "npm run build && electron-builder --win zip",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.local.bitalks.windowsdesktop",
    "productName": "Bi-Talks",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@whiskeysockets/baileys/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*"
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "extraResources": [
        {
          "from": "vendor/signal-desktop",
          "to": "vendor/signal-desktop"
        },
        {
          "from": "vendor/win32-window-helper",
          "to": "vendor/win32-window-helper"
        },
        {
          "from": "vendor/webview2-host",
          "to": "vendor/webview2-host",
          "filter": [
            "GoogleVoiceWebView2Host.exe",
            "GoogleVoiceTranslation.js",
            "Microsoft.Web.WebView2.Core.dll",
            "Microsoft.Web.WebView2.WinForms.dll",
            "WebView2Loader.dll"
          ]
        },
        {
          "from": "vendor/patch-updater",
          "to": "vendor/patch-updater",
          "filter": [
            "ApplyPatch.ps1"
          ]
        },
        {
          "from": "build/patch-channel.json",
          "to": "patch-channel.json"
        }
      ],
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "script": "build/installer.nsi",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    }
  },
  "allowScripts": {
    "electron@43.4.1": true
  }
}
